<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net8.0-windows10.0.22621.0</TargetFramework>
    <SupportedOSPlatformVersion>10.0.19041.0</SupportedOSPlatformVersion>
    <RootNamespace>SmartAuto.Infrastructure</RootNamespace>
    <AssemblyName>SmartAuto.Infrastructure</AssemblyName>
    <Platforms>x64</Platforms>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\SmartAuto.Abstractions\SmartAuto.Abstractions.csproj" />
    <ProjectReference Include="..\SmartAuto.Domain\SmartAuto.Domain.csproj" />
    <ProjectReference Include="..\SmartAuto.Application\SmartAuto.Application.csproj" />
    <ProjectReference Include="..\SmartAuto.Common\SmartAuto.Common.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Windows.CsWin32">
      <PrivateAssets>all</PrivateAssets>
    </PackageReference>
    <PackageReference Include="FlaUI.Core" />
    <PackageReference Include="FlaUI.UIA3" />
    <PackageReference Include="OpenCvSharp4" />
    <PackageReference Include="OpenCvSharp4.runtime.win" />
    <PackageReference Include="Tesseract" />
    <PackageReference Include="DynamicExpresso.Core" />
    <PackageReference Include="Polly" />
    <PackageReference Include="Polly.Extensions" />
    <PackageReference Include="Serilog" />
    <PackageReference Include="Serilog.Extensions.Logging" />
    <PackageReference Include="Microsoft.Extensions.Logging.Abstractions" />
    <PackageReference Include="Microsoft.Extensions.Hosting" />
  </ItemGroup>

  <!-- CsWin32 P/Invoke generation -->
  <ItemGroup>
    <AdditionalFiles Include="NativeMethods\NativeMethods.txt" />
  </ItemGroup>
</Project>
